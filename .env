# ============================================================
# BRN-Estavel — Variáveis de ambiente
# ------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores:
#     cp .env.example .env
#
# O arquivo ".env" está no .gitignore e NUNCA deve ser
# comitado. Este ".env.example" é o modelo público.
# ============================================================


# ============================================================
# 1) NGROK — Túnel público para o dashboard
# ============================================================
# Pegue seu token em: https://dashboard.ngrok.com/get-started/your-authtoken
# Deixe em branco se não for usar ngrok (o túnel será pulado).
NGROK_AUTHTOKEN=

# 1 = ativa o túnel ngrok quando o explorer sobe
# 0 = desativa (dashboard acessível apenas localmente)
BRN_USE_NGROK=1


# ============================================================
# 2) REDE P2P
# ============================================================
# Identificador da rede — nós com IDs diferentes não se conversam.
# Troque para isolar uma rede de testes da rede principal.
BRN_NETWORK_ID=brn-mainnet-1

# Interface onde o socket UDP escuta.
# 0.0.0.0 = todas as interfaces | 127.0.0.1 = só local
BRN_P2P_HOST=0.0.0.0

# Porta UDP do P2P. Se rodar vários nós na mesma máquina,
# cada um precisa de uma porta diferente (ex.: 7777, 7778).
BRN_P2P_PORT=7777

# Peers iniciais para sincronizar no boot.
# Formato: host1:porta1,host2:porta2 (separados por vírgula, SEM espaços).
# Exemplo: 127.0.0.1:7778,192.168.0.10:7777
BRN_SEED_PEERS=


# ============================================================
# 3) WEB / DASHBOARD
# ============================================================
# Interface do servidor Flask.
# 0.0.0.0 permite acesso de outras máquinas (necessário para ngrok).
BRN_WEB_HOST=0.0.0.0

# Porta HTTP do dashboard.
BRN_WEB_PORT=5000

# Porta usada pelo explorer.py (launcher alternativo)
BRN_EXPLORER_PORT=8080


# ============================================================
# 4) PERSISTÊNCIA
# ============================================================
# Caminho do banco SQLite da blockchain.
# Cada nó deve usar um arquivo próprio.
BRN_DB_PATH=blockchain.db

# Atalho alternativo usado pelo explorer.py
# (se ambos estiverem definidos, BRN_DB_PATH tem prioridade)
BRN_DB=blockchain.db

# Arquivo onde fica a identidade do nó (chave privada + endereço).
# Gerado automaticamente no primeiro boot.
BRN_IDENTITY_FILE=node_identity.json

# Arquivo onde fica a chave do faucet local.
# Também gerado automaticamente no primeiro boot.
BRN_FAUCET_KEY_FILE=faucet_identity.json


# ============================================================
# 5) CONSENSO (PoS)
# ============================================================
# Intervalo entre tentativas de produção de bloco (segundos).
BRN_TARGET_BLOCK_TIME=10

# Recompensa creditada ao validador que produz cada bloco (BRN).
BRN_BLOCK_REWARD=50

# Saldo mínimo para ser elegível como validador (BRN).
BRN_MIN_STAKE=100


# ============================================================
# 6) FAUCET (distribuição de tokens para testes)
# ============================================================
# Endereço que assina as transações do faucet.
# Deixe VAZIO: o node.py preenche automaticamente com o
# endereço do faucet_identity.json gerado localmente.
BRN_FAUCET_ADDRESS=

# Quanto o faucet envia por pedido (BRN).
BRN_FAUCET_AMOUNT=100

# Tempo de espera entre pedidos do mesmo endereço (segundos).
# 3600 = 1 hora
BRN_FAUCET_COOLDOWN=3600


# ============================================================
# 7) ALOCAÇÕES INICIAIS DE GÊNESE
# ============================================================
# Saldos criados na gênese (antes de qualquer bloco).
# Formato: endereco1:valor1,endereco2:valor2
# Sem espaços. Endereços começam com "brn1".
#
# Exemplo:
# BRN_GENESIS_ALLOC=brn1qxyzk7y0v2j4g0a8d9n5t3m2k7h4s6w8c9p2e:1000000,brn1abc123...:500000
#
# Deixe vazio para começar com todos os saldos em zero
# (o faucet local é automaticamente alocado no node.py).
BRN_GENESIS_ALLOC=


# ============================================================
# 8) RELATÓRIO DO EXPLORER
# ============================================================
# Intervalo, em segundos, entre cada relatório impresso no terminal
# pelo explorer.py (modo launcher).
BRN_REPORT_INTERVAL=30


# ============================================================
# 9) MINERAÇÃO / CONFIGURAÇÃO DE EXECUÇÃO
# ============================================================
# Endereço do minerador padrão usado pelo run.bat / run.sh.
# Se vazio, o node.py usa a identidade local (node_identity.json).
BRN_MINER=

# Porta P2P usada pelos launchers (run.bat / run.sh).
P2P_PORT=6001

# Porta do explorer usada pelos launchers.
EXPLORER_PORT=8080